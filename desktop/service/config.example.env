# Copie para desktop/service/.env no PC do streamer (NUNCA commit, NUNCA no frontend)

SUPABASE_URL=https://cudjcpheouvumwalslff.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
GAME_LIVE_TOKEN=

EDGE_FUNCTION_URL=https://cudjcpheouvumwalslff.supabase.co/functions/v1/game-live-events

PROCESSOR_ID=stream-pc-1
POLL_INTERVAL_MS=1500
BATCH_SIZE=10
LEASE_SECONDS=60
MAX_ATTEMPTS=5

STATUS_PENDING=pending
STATUS_PROCESSING=processing
STATUS_DONE=done
STATUS_FAILED=failed

# TikFinity: aponte o webhook/Event API do app para este URL local
TIKFINITY_LISTEN_HOST=127.0.0.1
TIKFINITY_LISTEN_PORT=8787
TIKFINITY_WEBHOOK_PATH=/tikfinity/event
# Opcional, se você tiver URL WS do Event API:
# TIKFINITY_WS_URL=
